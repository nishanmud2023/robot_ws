<?xml version="1.0"?>
<sdf version="1.6">
  <world name="hospital">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="outer_north"><static>true</static><pose>0 8 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>16 0.2 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>16 0.2 1</size></box></geometry><material><ambient>0.8 0.8 0.9 1</ambient><diffuse>0.8 0.8 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="outer_south"><static>true</static><pose>0 -8 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>16 0.2 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>16 0.2 1</size></box></geometry><material><ambient>0.8 0.8 0.9 1</ambient><diffuse>0.8 0.8 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="outer_east"><static>true</static><pose>8 0 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 16 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 16 1</size></box></geometry><material><ambient>0.8 0.8 0.9 1</ambient><diffuse>0.8 0.8 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="outer_west"><static>true</static><pose>-8 0 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 16 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 16 1</size></box></geometry><material><ambient>0.8 0.8 0.9 1</ambient><diffuse>0.8 0.8 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>

    <model name="corr_n_left"><static>true</static><pose>-5 2 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>6 0.2 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>6 0.2 1</size></box></geometry><material><ambient>0.7 0.7 0.85 1</ambient><diffuse>0.7 0.7 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="corr_n_right"><static>true</static><pose>4 2 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>6 0.2 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>6 0.2 1</size></box></geometry><material><ambient>0.7 0.7 0.85 1</ambient><diffuse>0.7 0.7 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="corr_s_left"><static>true</static><pose>-5 -2 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>6 0.2 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>6 0.2 1</size></box></geometry><material><ambient>0.7 0.7 0.85 1</ambient><diffuse>0.7 0.7 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="corr_s_right"><static>true</static><pose>4 -2 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>6 0.2 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>6 0.2 1</size></box></geometry><material><ambient>0.7 0.7 0.85 1</ambient><diffuse>0.7 0.7 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>

    <model name="div_n1_a"><static>true</static><pose>-4 5 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 2 1</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 2 1</size></box></geometry><material><ambient>0.7 0.7 0.85 1</ambient><diffuse>0.7 0.7 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    
    <model name="bed1"><static>true</static><pose>-6 5.5 0.3 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.5 0.8 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.5 0.8 0.5</size></box></geometry><material><ambient>0.9 0.9 1.0 1</ambient><diffuse>0.9 0.9 1.0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="nurse_desk"><static>true</static><pose>-6 0 0.4 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>2 0.8 0.8</size></box></geometry></collision><visual name="vis"><geometry><box><size>2 0.8 0.8</size></box></geometry><material><ambient>0.5 0.8 0.5 1</ambient><diffuse>0.5 0.8 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <model name="reception"><static>true</static><pose>6 0 0.4 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>2 0.8 0.8</size></box></geometry></collision><visual name="vis"><geometry><box><size>2 0.8 0.8</size></box></geometry><material><ambient>0.8 0.5 0.5 1</ambient><diffuse>0.8 0.5 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>

  </world>
</sdf>