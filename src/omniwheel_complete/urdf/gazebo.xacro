<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <gazebo>
    <plugin
      filename="gz-sim-mecanum-drive-system"
      name="gz::sim::systems::MecanumDrive">
      <front_left_joint>joint_front_left_wheel</front_left_joint>
      <front_right_joint>joint_front_right_wheel</front_right_joint>
      <back_left_joint>joint_rear_left_wheel</back_left_joint>
      <back_right_joint>joint_rear_right_wheel</back_right_joint>
      
      <front_right_joint_multiplier>-1.0</front_right_joint_multiplier>
      <back_right_joint_multiplier>-1.0</back_right_joint_multiplier>

      <wheel_radius>${wheel_r}</wheel_radius>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheelbase>${wheel_base}</wheelbase>
      
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Anisotropic "fake roller" friction.

       Two corrections vs. a naive first attempt:
       1) fdir1 must lie in the GROUND plane (X=forward, Y=left,
          Z=up -> the contact tangent plane is X-Y, NOT the wheel's
          own disc plane). A vector with a Z component gets
          projected onto X-Y and collapses to the same direction for
          every wheel - which is what caused "frictionless in every
          direction, still no strafe" last time.
       2) fdir1 is normally expressed in the wheel link's own frame,
          which spins with the wheel - so a correct-looking diagonal
          only holds for an instant. gz:expressed_in="base_link"
          pins the direction to the (non-rotating) chassis frame
          instead, which is required for this to work at all. This
          matches gz-sim's own mecanum_drive.sdf example.

       mu (=mu1) stays high along the wheel's rolling direction; mu2
       is the near-zero "roller can slide freely" direction, aimed
       along fdir1. Diagonals are mirrored X-pattern style: FL/RR
       share one, FR/RL the other. If strafing comes out backwards or
       the robot spins in place instead of sliding, flip the sign of
       every fdir1 vector below (swap the two diagonal assignments). -->
  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.3</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.3</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.3</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.3</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="lidar_sensor_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_sensor_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="lidar_sensor_mount">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <gz_frame_id>lidar_sensor_mount</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle> 
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="imu_sensor_mount">
    <sensor name="imu_sensor" type="imu">
      <gz_frame_id>imu_sensor_mount</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>/imu</topic>
    </sensor>
  </gazebo>

</robot>
